# 渲染主机：/etc/systemd/system/serve-configs.service（或 systemctl --user）
[Unit]
Description=Serve rendered mihomo configs on tailnet
After=tailscaled.service network-online.target

[Service]
WorkingDirectory=/opt/clash-override-chain-proxy
ExecStart=/usr/bin/node scripts/serve-configs.js --listen 100.64.0.1:7898
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
