# 主机侧：/etc/mihomo-pull.env（chmod 600）
PULL_URL=http://100.64.0.1:7898/myhost.yaml
PULL_TOKEN=<本机的 PUBLISH_TOKEN_MYHOST>
MIHOMO_BIN=/usr/local/bin/mihomo
MIHOMO_DIR=/etc/mihomo
MIHOMO_CONFIG=/etc/mihomo/config.yaml
# cron 写法（无 systemd）：*/5 * * * * /usr/local/bin/mihomo-pull.sh /etc/mihomo-pull.env >>/var/log/mihomo-pull.log 2>&1
