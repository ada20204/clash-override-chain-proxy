# 复制为本地 secrets.env，不要提交。POSIX 使用 chmod 600；Windows 检查文件 ACL。
# 下列地址和凭证均为占位值，需替换后使用。环境变量同名时优先。
SUB_URL_MAIN=https://example.com/sub?token=xxx
CONTROLLER_SECRET=replace-with-a-random-secret
# 可选出口：未使用时保持注释，对应 optional 节点会跳过。
# HOME_PROXY_URL=http://user:pass@203.0.113.10:443
# CN_EXIT_URL=socks5://user:pass@198.51.100.20:1080
# FRONT_PROXY_URL=socks5://user:pass@192.0.2.30:1080
